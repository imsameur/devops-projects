[Unit]
Description=Renew Project 06 TLS certificate and reload Nginx
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/devops-projects/nginx-reverse-proxy
ExecStart=/home/ec2-user/devops-projects/nginx-reverse-proxy/scripts/renew-cert.sh
